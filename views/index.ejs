<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>eBookShala | Your Digital Library</title>
    <link rel="icon" type="image/svg+xml" href="/logo/eBookShala_Logo.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700;800&display=swap"
        rel="stylesheet">
    <style>
        body {
            margin: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #F8F5E9;
            color: #333;
            -webkit-font-smoothing: antialiased; 
            -moz-osx-font-smoothing: grayscale;
        }

        h1, h2, h3, .logo, .section-title, #typing-headline {
            font-family: 'Playfair Display', serif;
            letter-spacing: -0.5px; 
        }

        .hero-section {
            width: 100%;
            height: 100vh;
            position: relative;
            overflow: hidden;
        }

        .hero-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }

        .video-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.7) 100%);
            z-index: 2;
        }

        .hero-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
            text-align: center;
            width: 90%;
            max-width: 900px; 
        }

        #typing-headline {
            font-size: clamp(40px, 8vw, 72px); 
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 15px 0;
            min-height: clamp(45px, 8vw, 80px); 
            text-shadow: 2px 4px 8px rgba(0, 0, 0, 0.5);
            letter-spacing: 1px;
        }

        #typing-paragraph {
            font-size: clamp(16px, 2.5vw, 24px);
            color: #f8f8f8;
            line-height: 1.6;
            margin: 0 auto;
            max-width: 700px;
            min-height: 80px; 
            text-shadow: 1px 2px 4px rgba(0, 0, 0, 0.5);
        }

        .cursor::after {
            content: '|';
            animation: blink 0.8s infinite;
            color: #ffffff;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        .cta-container {
            margin-top: 35px;
            opacity: 0; 
            transform: translateY(20px);
            transition: opacity 1s ease, transform 1s ease;
            display: flex;
            justify-content: center;
            gap: 15px;
        }

        .cta-container.show {
            opacity: 1;
            transform: translateY(0); 
        }

        .btn {
            padding: 14px 32px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 30px;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .btn-primary {
            background-color: #d32f2f;
            color: white;
            border: 2px solid #d32f2f;
            box-shadow: 0 4px 15px rgba(211, 47, 47, 0.4);
        }

        .btn-primary:hover {
            background-color: #b71c1c;
            border-color: #b71c1c;
            transform: translateY(-3px);
        }

        .btn-secondary {
            background-color: transparent;
            color: white;
            border: 2px solid white;
        }

        .btn-secondary:hover {
            background-color: white;
            color: #333;
            transform: translateY(-3px);
        }

        .features-section {
            background-color: white;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
            gap: 40px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            position: relative;
            z-index: 4;
        }

        .feature-box {
            text-align: center;
            max-width: 250px;
        }

        .feature-box h3 {
            font-size: 18px;
            color: #d32f2f;
            margin-bottom: 10px;
        }

        .feature-box p {
            font-size: 14px;
            color: #666;
            margin: 0;
            line-height: 1.5;
        }

        .trending-section {
            padding: 60px 50px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            font-size: 28px;
            color: #333;
            margin-bottom: 30px;
            text-align: left;
            position: relative;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 60px;
            height: 4px;
            background-color: #d32f2f;
            margin-top: 10px;
            border-radius: 2px;
        }

        .trending-container {
            display: flex;
            gap: 25px;
            overflow-x: auto;
            padding-bottom: 20px;
            scrollbar-width: thin;
            scrollbar-color: #d32f2f #eee;
        }

        .trending-container::-webkit-scrollbar {
            height: 8px;
        }
        .trending-container::-webkit-scrollbar-track {
            background: #eee; 
            border-radius: 4px;
        }
        .trending-container::-webkit-scrollbar-thumb {
            background-color: #d32f2f; 
            border-radius: 4px;
        }

        .reveal-card {
            opacity: 0; 
            transform: translateX(100px); 
            transition: opacity 0.8s ease-out, transform 0.8s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        .reveal-card.show {
            opacity: 1;
            transform: translateX(0); 
        }

        .trending-container::-webkit-scrollbar {
            height: 8px;
        }
        .trending-container::-webkit-scrollbar-track {
            background: #eee; 
            border-radius: 4px;
        }
        .trending-container::-webkit-scrollbar-thumb {
            background-color: #d32f2f; 
            border-radius: 4px;
        }

        .card {
            background-color: white;
            padding: 15px;
            min-width: 180px;
            max-width: 180px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
            display: flex;
            flex-direction: column;
            border-radius: 8px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.15);
        }

        .card img {
            width: 100%;
            height: 260px;
            object-fit: cover;
            margin-bottom: 15px;
            border-radius: 4px;
            transition: opacity 0.3s ease;
        }

        .card:hover img {
            opacity: 0.9;
        }

        .card-title {
            font-size: 16px;
            font-weight: bold;
            margin: 0 0 6px 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #333;
        }

        .card-author {
            font-size: 13px;
            color: #777;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .about-platform-section {
            background-color: white;
            padding: 80px 60px;
            max-width: 1100px;
            margin: 40px auto 80px auto;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
        }

        .about-header {
            text-align: center;
            max-width: 800px;
            margin: 0 auto 50px auto;
        }

        .center-title {
            text-align: center;
        }

        .center-title::after {
            margin: 15px auto 0 auto; 
        }

        .about-description {
            font-size: 18px;
            line-height: 1.8;
            color: #555;
            margin-top: 25px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .info-card {
            background-color: #F8F5E9; 
            padding: 40px 30px;
            border-radius: 16px;
            text-align: center;
            border: 1px solid rgba(0,0,0,0.03);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .info-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.06);
            background-color: #fff;
        }

        .info-icon {
            font-size: 45px;
            margin-bottom: 20px;
        }

        .info-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            color: #333;
            margin: 0 0 15px 0;
        }

        .info-card p {
            font-size: 15px;
            color: #666;
            line-height: 1.6;
            margin: 0;
        }

        .about-logo {
            width: 70px;
            height: auto;
            display: block;
            margin: 0 auto 20px auto;
            filter: brightness(0); 
            transform: perspective(600px) rotateY(0deg);
            transition: transform 1.5s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        .about-logo.spin-once {
            transform: perspective(600px) rotateY(360deg);
        }

        .info-icon {
            margin-bottom: 20px;
            display: flex;
            justify-content: center;
        }

        .info-icon svg {
            color: #d32f2f;
            transition: transform 0.3s ease;
        }

        .info-card:hover .info-icon svg {
            transform: translateY(-5px);
        }


        @media (max-width: 900px) {
            .features-section {
                gap: 20px;
                padding: 30px 15px;
            }
            .trending-section {
                padding: 40px 30px;
            }

            .about-platform-section {
                padding: 60px 40px;
                margin: 20px 20px 60px 20px;
            }
        }

        @media (max-width: 600px) {
            .hero-content {
                width: 95%;
            }
            
            .cta-container {
                flex-direction: column;
                align-items: center;
                gap: 10px;
            }

            .btn {
                width: 80%;
                text-align: center;
            }

            .features-section {
                flex-direction: column;
                align-items: center;
                gap: 30px;
            }

            .trending-section {
                padding: 40px 15px;
            }

            .card {
                min-width: 140px;
                max-width: 140px;
                padding: 10px;
            }

            .card img {
                height: 200px;
            }

            .about-platform-section {
                padding: 40px 20px;
                margin: 20px 15px 40px 15px;
            }

            .about-description {
                font-size: 16px;
            }

            .info-card {
                padding: 30px 20px;
            }
        }
    </style>
</head>

<body>

    <%- include('partials/navBar') %>

        <div class="hero-section">
            <video autoplay loop muted playsinline class="hero-video">
                <source src="/videos/heroSectionVideo.mp4" type="video/mp4">
            </video>
            
            <div class="video-overlay"></div>

            <div class="hero-content">
                <h1 id="typing-headline"></h1>
                <p id="typing-paragraph"></p>
                
                <div class="cta-container" id="cta-buttons">
                    <a href="/catalog" class="btn btn-primary">Browse Catalog</a>
                    <a href="/signup" class="btn btn-secondary">Join for Free</a>
                </div>
            </div>
        </div>

        <div class="features-section">
            <div class="feature-box">
                <h3> Massive Library</h3>
                <p>Access thousands of bestsellers, academic texts, and hidden indie gems.</p>
            </div>
            <div class="feature-box">
                <h3> Read Anywhere</h3>
                <p>Seamlessly sync your reading progress across your phone, tablet, and PC.</p>
            </div>
            <div class="feature-box">
                <h3> Offline Access</h3>
                <p>Download your favorite titles and read them anytime without the internet.</p>
            </div>
        </div>

        <div class="trending-section">
            <h2 class="section-title">Trending Now</h2>

            <div class="trending-container">
                <% trendingBooks.forEach(function(book) { %>
                    <a href="/book/<%= book.id %>" class="reveal-card" style="text-decoration: none; color: inherit;">
                        <div class="card" style="cursor: pointer;">
                            <img src="<%= book.formats['image/jpeg'] ? book.formats['image/jpeg'] : 'https://via.placeholder.com/150x240?text=No+Cover' %>"
                                alt="<%= book.title %>">

                            <p class="card-title">
                                <%= book.title %>
                            </p>

                            <p class="card-author">
                                <%= book.authors.length > 0 ? book.authors[0].name : "Unknown Author" %>
                            </p>
                        </div>
                    </a>
                <% }) %>
            </div>
        </div>

        <div class="about-platform-section">
            <div class="about-header">
                <img src="/logo/eBookShala_Logo.svg" alt="eBookShala Logo" class="about-logo" id="rotating-logo">
                
                <h2 class="section-title center-title">About eBookShala</h2>
                <p class="about-description">
                    eBookShala is your premier digital sanctuary for knowledge and imagination. We believe that reading should be accessible to everyone, breaking down the barriers of traditional reading. Whether you are looking for academic resources, timeless classics, or your next fiction adventure, we bring the world's best books directly to your screen.
                </p>
            </div>

            <div class="info-grid">
                <div class="info-card">
                    <div class="info-icon">
                        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"></path>
                        </svg>
                    </div>
                    <h3>Vast Collection</h3>
                    <p>Explore thousands of curated titles. From historical archives to modern thrillers, our library is constantly growing to feed your curiosity.</p>
                </div>
                
                <div class="info-card">
                    <div class="info-icon">
                        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"></path>
                        </svg>
                    </div>
                    <h3>Read Anywhere</h3>
                    <p>Start a book on your laptop and pick up right where you left off on your mobile phone. Your personal library syncs perfectly across all devices.</p>
                </div>
                
                <div class="info-card">
                    <div class="info-icon">
                        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"></path>
                        </svg>
                    </div>
                    <h3>Ad-Free Focus</h3>
                    <p>Enjoy a completely distraction-free reading environment. No pop-ups, no ads—just you and the story you are immersed in.</p>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>

</body>

<script>
        const headlineText = "Welcome to eBookShalla";
        const paragraphText = "Your ultimate digital library. Dive into thousands of captivating stories, insightful non-fiction, and academic resources. Read anytime, anywhere.";

        const headlineElement = document.getElementById('typing-headline');
        const paragraphElement = document.getElementById('typing-paragraph');
        const ctaButtons = document.getElementById('cta-buttons');

        let headlineIndex = 0;
        let paragraphIndex = 0;

        function typeWriter() {
            if (headlineIndex < headlineText.length) {
                headlineElement.innerHTML = headlineText.substring(0, headlineIndex + 1) + '<span class="cursor"></span>';
                headlineIndex++;
                setTimeout(typeWriter, 80); 
            } else if (paragraphIndex < paragraphText.length) {
                headlineElement.innerHTML = headlineText; 
                paragraphElement.innerHTML = paragraphText.substring(0, paragraphIndex + 1) + '<span class="cursor"></span>';
                paragraphIndex++;
                setTimeout(typeWriter, 30);
            } else {
                paragraphElement.innerHTML = paragraphText; 
                ctaButtons.classList.add('show');
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            setTimeout(typeWriter, 500); 
        });

        window.addEventListener('DOMContentLoaded', () => {
            const observerOptions = {
                root: null,
                rootMargin: '0px',
                threshold: 0.1 
            };

            const observer = new IntersectionObserver((entries, observer) => {
                entries.forEach((entry, index) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.classList.add('show');
                        }, index * 150); 
                        
                        observer.unobserve(entry.target); 
                    }
                });
            }, observerOptions);

            const cardsToReveal = document.querySelectorAll('.reveal-card, .reveal-left, .reveal-right');
            cardsToReveal.forEach(card => {
                observer.observe(card);
            });
        });

        window.addEventListener('DOMContentLoaded', () => {
            const logo = document.getElementById('rotating-logo');
            
            if (logo) {
                const logoObserver = new IntersectionObserver((entries, observer) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            
                            entry.target.classList.add('spin-once');
                            
                            observer.unobserve(entry.target);
                        }
                    });
                }, {
                    root: null,
                    rootMargin: '0px',
                    threshold: 0.5 
                });

                logoObserver.observe(logo);
            }
        });
</script>
</html>