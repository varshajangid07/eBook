<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= book.title %>
    </title>
    <style>
        body {
            background-color: #f6f3eb;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 30px 5%;
            color: #222;
        }

        .top-red-bar {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 30px;
            margin-bottom: 40px;
            background-color: #783535;
            z-index: 100;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .header a,
        .header button {
            background: none;
            border: none;
            color: #333;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px;
            transition: transform 0.2s ease, color 0.2s ease;
        }

        .header a:hover {
            transform: translateX(-4px);
        }

        .header button:hover {
            color: #783535;
            transform: scale(1.15);
        }

        .cover-wrapper {
            text-align: center;
            margin-bottom: 30px;
        }

        .cover-wrapper img {
            width: 320px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            border-radius: 8px;
        }

        .read-btn {
            display: block;
            width: fit-content;
            margin: 0 auto 40px auto;
            background-color: #000;
            color: #fff;
            padding: 12px 40px;
            border-radius: 30px;
            text-decoration: none;
            font-size: 16px;
            font-weight: bold;
            transition: background-color 0.2s ease;
        }

        .read-btn:hover {
            background-color: #333;
        }

        .details-card {
            background: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            margin-bottom: 40px;
        }

        .synopsis-text {
            color: #444;
            line-height: 1.8;
            font-size: 16px;
            margin-bottom: 30px;
        }

        .meta-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
            border-top: 1px solid #eee;
            padding-top: 20px;
        }

        .meta-row {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .meta-label {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #888;
            font-weight: bold;
        }

        .tags-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tag {
            background-color: #f4f4f4;
            color: #333;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
        }

        .tag-outline {
            background-color: transparent;
            border: 1px solid #ddd;
            color: #555;
        }

        @media (min-width: 600px) {
            .meta-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        .more-books-section {
            margin-top: 60px;
        }

        .more-books-section h3 {
            font-size: 20px;
            color: #444;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .more-books-container {
            display: flex;
            gap: 20px;
            overflow-x: auto;
            padding-bottom: 15px;
        }

        .more-books-container::-webkit-scrollbar {
            height: 8px;
        }

        .more-books-container::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 10px;
        }

        .small-card {
            background-color: #fff;
            padding: 12px;
            border-radius: 6px;
            min-width: 160px;
            text-decoration: none;
            color: inherit;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .small-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
        }

        .small-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            margin-bottom: 10px;
            border-radius: 4px;
            transition: opacity 0.3s ease;
        }

        .small-card:hover img {
            opacity: 0.9;
        }

        .small-card .title {
            font-size: 14px;
            font-weight: bold;
            margin: 0 0 4px 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 140px;
        }

        .small-card .author {
            font-size: 12px;
            color: #777;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 140px;
        }

        .comment-like-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 13px;
            font-weight: bold;
            transition: color 0.2s;
            color: #666;
        }

        .comment-like-btn svg {
            fill: none;
        }

        .comment-like-btn.liked {
            color: #d32f2f;
        }

        .comment-like-btn.liked svg {
            fill: #d32f2f;
        }
    </style>
</head>

<body>
    <div class="top-red-bar"></div>
<div class="container">

    <div class="header">
        <a href="/">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                stroke="currentColor" style="width: 26px; height: 26px;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
        </a>
        <div style="display: flex; gap: 15px; align-items: center;">
            <button id="share-btn" title="Share this book">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                    stroke="currentColor" style="width: 26px; height: 26px;">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
                </svg>
            </button>

            <button title="Bookmark this book" id="bookmarkBtn" data-id="<%= book.id %>"
                data-title="<%= book.title.split('"').join('&quot;') %>" 
                data-author="<%= book.authors.length > 0 ? book.authors[0].name.split('"').join('&quot;') : 'Unknown Author' %>"
                onclick="toggleBookmark(this)">
                <svg id="bookmarkIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                    stroke-width="2" stroke="currentColor" style="width: 26px; height: 26px;">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                </svg>
            </button>

            <button title="Save to Favorites" id="likeBtn" data-id="<%= book.id %>"
                data-title="<%= book.title.split('"').join('&quot;') %>" 
                data-author="<%= book.authors.length > 0 ? book.authors[0].name.split('"').join('&quot;') : 'Unknown Author' %>"
                onclick="toggleLike(this)">
                <svg id="likeIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                    stroke-width="2" stroke="currentColor" style="width: 28px; height: 28px;">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                </svg>
            </button>
        </div>
    </div>

    <div class="cover-wrapper">
        <img src="<%= book.formats['image/jpeg'] ? book.formats['image/jpeg'] : 'https://via.placeholder.com/200x300?text=No+Cover' %>"
            alt="Cover of <%= book.title %>">
    </div>

    <div style="text-align: center; margin-bottom: 25px;">
        <h1 style="margin: 0 0 8px 0; font-size: 26px; color: #111;">
            <%= book.title %>
        </h1>
        <h3 style="margin: 0; font-size: 18px; color: #666; font-weight: normal;">
            By <%= book.authors.length > 0 ? book.authors[0].name : "Unknown Author" %>
        </h3>
    </div>

    <% 
        let cleanGenres = book.bookshelves ? book.bookshelves.map(g => g.replace(/Category: |Browse /g, '')) : ['Literature'];
        let rawTopics = book.subjects ? book.subjects.map(s => s.split(' -- ')[0]) : [];
        let cleanTopics = [...new Set(rawTopics)].slice(0, 5);
        const readLink = book.formats['text/html'] || book.formats['application/epub+zip'] || '#';
    %>

    <a href="<%= readLink %>" class="read-btn" target="_blank">Read Book</a>

    <div class="details-card">
        <h3 style="margin-top: 0; font-size: 20px; color: #222;">Synopsis</h3>
        <p class="synopsis-text">
            Dive into the classic world of <em><%= book.title %></em>. This text is provided for free by the Project Gutenberg library. Enjoy exploring timeless themes and historical context preserved within this digitized edition.
        </p>

        <div class="meta-grid">
            <div class="meta-row">
                <span class="meta-label">Language</span>
                <span style="font-weight: bold; color: #222;">
                    <%= book.languages ? book.languages.join(', ').toUpperCase() : ' EN' %>
                </span>
            </div>

            <div class="meta-row">
                <span class="meta-label">Genres</span>
                <div class="tags-wrapper">
                    <% if (cleanGenres.length > 0) { %>
                        <% cleanGenres.forEach(function(genre) { %>
                            <span class="tag"><%= genre %></span>
                        <% }) %>
                    <% } else { %>
                        <span class="tag">General</span>
                    <% } %>
                </div>
            </div>

            <div class="meta-row" style="grid-column: 1 / -1;">
                <span class="meta-label">Topics & Themes</span>
                <div class="tags-wrapper">
                    <% if (cleanTopics.length > 0) { %>
                        <% cleanTopics.forEach(function(topic) { %>
                            <span class="tag tag-outline"><%= topic %></span>
                        <% }) %>
                    <% } else { %>
                        <span class="tag tag-outline">Classic Literature</span>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <div class="more-books-section">
        <h3>More Books</h3>
        <div class="more-books-container">
            <% similarBooks.forEach(function(simBook) { %>
                <a href="/book/<%= simBook.id %>" class="small-card">
                    <img src="<%= simBook.formats['image/jpeg'] ? simBook.formats['image/jpeg'] : 'https://via.placeholder.com/120x160?text=No+Cover' %>"
                        alt="<%= simBook.title %>">
                    <p class="title"><%= simBook.title %></p>
                    <p class="author"><%= simBook.authors.length > 0 ? simBook.authors[0].name : "Unknown" %></p>
                </a>
            <% }) %>
        </div>
    </div>

    <div class="details-card" style="margin-top: 60px; margin-bottom: 40px;">
        <h3 style="margin-top: 0; font-size: 20px; color: #222; border-bottom: 1px solid #eee; padding-bottom: 15px; margin-bottom: 25px;">
            Community Reviews (<%= comments ? comments.length : 0 %>)
        </h3>

        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <div style="display: flex; gap: 15px; margin-bottom: 30px;">
                <img src="<%= currentUser.profilePhoto ? currentUser.profilePhoto : 'https://ui-avatars.com/api/?name=' + currentUser.name + '&background=783535&color=fff' %>"
                    style="width: 45px; height: 45px; border-radius: 50%; object-fit: cover;" alt="You">
                <div style="flex: 1;">
                    <textarea id="commentText" placeholder="What did you think of this book?"
                        style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 8px; font-family: inherit; font-size: 15px; resize: vertical; min-height: 80px; box-sizing: border-box;"></textarea>
                    <button onclick="submitComment()"
                        style="margin-top: 10px; background: #783535; color: #fff; border: none; padding: 10px 20px; border-radius: 6px; font-weight: bold; cursor: pointer; float: right;">
                        Post Comment
                    </button>
                </div>
            </div>
        <% } else { %>
            <div style="background: #f9f9f9; padding: 20px; text-align: center; border-radius: 8px; margin-bottom: 30px; border: 1px dashed #ccc;">
                <p style="margin: 0; color: #555;">Please <a href="/login" style="color: #783535; font-weight: bold;">Log In</a> to leave a comment.</p>
            </div>
        <% } %>

        <div style="display: flex; flex-direction: column; gap: 25px; clear: both; padding-top: 20px;">
            <% if (!comments || comments.length === 0) { %>
                <p style="text-align: center; color: #888;">No reviews yet. Be the first to share your thoughts!</p>
            <% } else { %>
                <% comments.forEach(comment => {
                    const dateOptions = { year: 'numeric', month: 'short', day: 'numeric' };
                    const formattedDate = new Date(comment.createdAt).toLocaleDateString('en-US', dateOptions);

                    let userLikedComment = false;
                    let isOwner = false;
                    if (typeof currentUser !== 'undefined' && currentUser) {
                        userLikedComment = comment.likes.some(id => id.toString() === currentUser._id.toString());
                        isOwner = currentUser._id.toString() === comment.user._id.toString();
                    }
                %>
                    <div style="display: flex; gap: 15px; margin-bottom: 25px;">
                        <img src="<%= comment.user.profilePhoto ? comment.user.profilePhoto : 'https://ui-avatars.com/api/?name=' + comment.user.name + '&background=eee&color=333' %>"
                            style="width: 45px; height: 45px; border-radius: 50%; object-fit: cover;" alt="<%= comment.user.name %>">

                        <div style="flex: 1; background: #f9f9f9; padding: 15px; border-radius: 8px; border: 1px solid #eee;">
                            
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <strong style="color: #222; font-size: 15px;">
                                    <%= comment.user.name %> 
                                    <% if (isOwner) { %> <span style="color: #888; font-size: 12px; font-weight: normal; margin-left: 3px;">(you)</span> <% } %>
                                </strong>
                                
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <span style="color: #888; font-size: 12px;">
                                        <%= formattedDate %>
                                        <% if (comment.isEdited) { %> <span style="font-style: italic; margin-left: 5px;">(edited)</span> <% } %>
                                    </span>

                                    <% if (isOwner) { %>
                                        <div class="kebab-menu" style="position: relative; display: flex; align-items: center;">
                                            <svg onclick="toggleDropdown('dropdown-<%= comment._id %>')" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" style="width: 20px; height: 20px; color: #888; cursor: pointer;">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z" />
                                            </svg>
                                            
                                            <div id="dropdown-<%= comment._id %>" class="kebab-dropdown" style="display: none; position: absolute; top: 25px; right: 0; background: white; border: 1px solid #ddd; border-radius: 6px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); z-index: 10; width: 100px; overflow: hidden;">
                                                <div onclick="toggleEditBox('<%= comment._id %>'); toggleDropdown('dropdown-<%= comment._id %>')" style="padding: 10px; cursor: pointer; font-size: 13px; color: #333; border-bottom: 1px solid #f0f0f0; background: #fff;" onmouseover="this.style.background='#f9f9f9'" onmouseout="this.style.background='#fff'">Edit</div>
                                                <div onclick="deleteComment('<%= comment._id %>')" style="padding: 10px; cursor: pointer; font-size: 13px; color: #d32f2f; background: #fff;" onmouseover="this.style.background='#fcf2f2'" onmouseout="this.style.background='#fff'">Delete</div>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <p id="text-<%= comment._id %>" style="margin: 0 0 12px 0; color: #444; line-height: 1.5; font-size: 14.5px;">
                                <%= comment.text %>
                            </p>

                            <div id="edit-box-<%= comment._id %>" style="display: none; margin-bottom: 12px;">
                                <textarea id="edit-input-<%= comment._id %>" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; font-family: inherit;"><%= comment.text %></textarea>
                                <div style="margin-top: 5px;">
                                    <button onclick="submitEdit('<%= comment._id %>')" style="padding: 6px 12px; background: #783535; color: white; border: none; border-radius: 5px; cursor: pointer;">Save</button>
                                    <button onclick="toggleEditBox('<%= comment._id %>')" style="padding: 6px 12px; background: #eee; border: none; border-radius: 5px; cursor: pointer; color: #333;">Cancel</button>
                                </div>
                            </div>

                            <div style="display: flex; align-items: center; gap: 15px;">
                                <button onclick="likeComment(this, '<%= comment._id %>')"
                                    class="comment-like-btn <%= userLikedComment ? 'liked' : '' %>"
                                    style="background:none; border:none; cursor:pointer; display:flex; align-items:center; gap:5px; padding:0; color: <%= userLikedComment ? '#783535' : '#888' %>;">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 16px; height: 16px;">
                                        <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                                    </svg>
                                    <span class="like-count" id="like-count-<%= comment._id %>"><%= comment.likes.length %></span>
                                </button>

                                <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                                    <span onclick="toggleReplyBox('<%= comment._id %>')" style="cursor:pointer; color:#666; font-size:13px; font-weight:bold;">Reply</span>
                                <% } %>
                            </div>

                            <div id="reply-box-<%= comment._id %>" style="display: none; margin-top: 15px; border-top: 1px dashed #ccc; padding-top: 15px;">
                                <textarea id="reply-input-<%= comment._id %>" placeholder="Write a reply..."
                                    style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; font-family: inherit; font-size: 14px; min-height: 60px;"></textarea>
                                <div style="margin-top: 5px;">
                                    <button onclick="submitReply('<%= comment._id %>')" style="padding: 6px 12px; background: #783535; color: white; border: none; border-radius: 5px; cursor: pointer;">Post Reply</button>
                                    <button onclick="toggleReplyBox('<%= comment._id %>')" style="padding: 6px 12px; background: #eee; border: none; border-radius: 5px; cursor: pointer; color: #333;">Cancel</button>
                                </div>
                            </div>

                            <% if (comment.replies && comment.replies.length > 0) { %>
                                <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #eee;">
                                    <% comment.replies.forEach(reply => { 
                                        const replyDate = new Date(reply.createdAt).toLocaleDateString('en-US', dateOptions);
                                        let isReplyOwner = false;
                                        if (typeof currentUser !== 'undefined' && currentUser) {
                                            isReplyOwner = currentUser._id.toString() === reply.user._id.toString();
                                        }
                                    %>
                                        <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                                            <img src="<%= reply.user.profilePhoto ? reply.user.profilePhoto : 'https://ui-avatars.com/api/?name=' + reply.user.name + '&background=ccc&color=333' %>"
                                                style="width: 30px; height: 30px; border-radius: 50%; object-fit: cover;">
                                            <div style="flex: 1;">
                                                <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                                                    <strong style="color: #333; font-size: 13px;">
                                                        <%= reply.user.name %>
                                                        <% if (isReplyOwner) { %> <span style="color: #888; font-size: 11px; font-weight: normal; margin-left: 2px;">(you)</span> <% } %>
                                                    </strong>
                                                    <span style="color: #aaa; font-size: 11px;"><%= replyDate %></span>
                                                </div>
                                                <p style="margin: 0; font-size: 13.5px; color: #555;"><%= reply.text %></p>
                                                
                                                <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                                                    <span onclick="toggleReplyBox('<%= comment._id %>', '<%= reply.user.name %>')" style="cursor:pointer; color:#888; font-size:12px; font-weight:bold; margin-top: 5px; display: inline-block;">Reply</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>

                        </div> 
                    </div> 
                <% }) %>
            <% } %>
        </div>
    </div>
</div> 

<script src="/socket.io/socket.io.js"></script>
<script>
    function toggleDropdown(dropdownId) {
        document.querySelectorAll('.kebab-dropdown').forEach(d => {
            if (d.id !== dropdownId) d.style.display = 'none';
        });
        const dropdown = document.getElementById(dropdownId);
        dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
    }

    window.addEventListener('click', function(e) {
        if (!e.target.closest('.kebab-menu')) {
            document.querySelectorAll('.kebab-dropdown').forEach(d => d.style.display = 'none');
        }
    });

    function toggleReplyBox(commentId, replyToName = '') {
        const box = document.getElementById(`reply-box-${commentId}`);
        const input = document.getElementById(`reply-input-${commentId}`);
        box.style.display = 'block';

        if (replyToName) {
            input.value = `@${replyToName} `;
        } else if (!input.value.startsWith('@')) {
            input.value = '';
        }
        input.focus();
    }

    function toggleEditBox(commentId) {
        const box = document.getElementById(`edit-box-${commentId}`);
        const text = document.getElementById(`text-${commentId}`);
        if (box.style.display === 'none') {
            box.style.display = 'block';
            text.style.display = 'none'; 
        } else {
            box.style.display = 'none';
            text.style.display = 'block'; 
        }
    }

    async function submitReply(commentId) {
        const text = document.getElementById(`reply-input-${commentId}`).value;
        if (!text.trim()) return alert("Reply cannot be empty!");
        
        try {
            const res = await fetch(`/book/<%= book.id %>/comment/${commentId}/reply`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text })
            });
            if (res.ok) document.getElementById(`reply-input-${commentId}`).value = ''; 
            else alert("Error posting reply.");
        } catch (err) { console.error(err); }
    }

    async function submitEdit(commentId) {
        const text = document.getElementById(`edit-input-${commentId}`).value;
        if (!text.trim()) return alert("Comment cannot be empty!");
        
        try {
            const res = await fetch(`/book/<%= book.id %>/comment/${commentId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text })
            });
            if (!res.ok) alert("Error editing comment.");
        } catch (err) { console.error(err); }
    }

    async function deleteComment(commentId) {
        if (!confirm("Are you sure you want to permanently delete this comment?")) return;
        
        try {
            const res = await fetch(`/book/<%= book.id %>/comment/${commentId}`, { method: 'DELETE' });
            if (!res.ok) alert("Error deleting comment.");
        } catch (err) { console.error(err); }
    }

    async function submitComment() {
        const text = document.getElementById('commentText').value;
        if (!text.trim()) return alert("Comment cannot be empty!");
        try {
            const res = await fetch(`/book/<%= book.id %>/comment`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    text: text, 
                    title: <%- JSON.stringify(book.title) %>, 
                    author: <%- JSON.stringify(book.authors.length > 0 ? book.authors[0].name : 'Unknown Author') %> 
                })
            });
            if (res.ok) document.getElementById('commentText').value = '';
            else alert("Error posting comment.");
        } catch (err) { console.error(err); }
    }

    async function likeComment(btn, commentId) {
        try {
            const res = await fetch(`/book/<%= book.id %>/comment/${commentId}/like`, { method: 'POST' });
            const data = await res.json();
            if (data.error) return alert(data.error);

            const countSpan = document.getElementById(`like-count-${commentId}`);
            countSpan.innerText = data.likesCount;
            btn.style.color = data.hasLiked ? '#783535' : '#888';
        } catch (error) { console.error(error); }
    }

    const socket = io();
    const currentBookId = '<%= book.id %>';
    
    socket.emit('join-book', currentBookId);

    socket.on('update-like', (data) => {
        const likeCounter = document.getElementById(`like-count-${data.commentId}`);
        if (likeCounter) {
            likeCounter.innerText = data.likesCount;
            likeCounter.style.transform = 'scale(1.5)';
            likeCounter.style.transition = 'transform 0.2s';
            setTimeout(() => likeCounter.style.transform = 'scale(1)', 200);
        }
    });

    socket.on('new-comment', () => {
        window.location.reload();
    });
</script>